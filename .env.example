# ---- frontend (Vite, baked in at build time) ----
# Which data backend the app uses: "local" (browser localStorage, fake sign-in; the default for
# `npm run dev` and the e2e tests) or "api" (the app's own server; the default for production builds).
# VITE_STORE=api

# Public address of the deployed app, used by the Share button. Defaults to the page's own origin.
# VITE_APP_URL=https://your-domain.example

# ---- server (read at run time; set these as Replit Secrets, never in the frontend) ----
# Postgres connection string. Replit's Database tool sets DATABASE_URL for you.
# Locally, `pglite://.data/dev` runs an embedded Postgres with no install.
# DATABASE_URL=pglite://.data/dev

# Port to listen on (Replit maps 3000 to the public port).
# PORT=3000

# Folder with the built frontend to serve (default dist).
# STATIC_DIR=dist

# Secure cookies default ON when running on Replit (REPL_ID is set). Set 0 for plain http locally.
# SECURE_COOKIES=0
