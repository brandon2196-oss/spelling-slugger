# Replit configuration for Cooper's Spelling Slugger (Autoscale deployment + Replit Postgres).
modules = ["nodejs-22"]

[nix]
channel = "stable-25_05"

# Workspace "Run": install, build frontend + server, serve on :3000 (same as production).
[workflows]
runButton = "Spelling Slugger"

[[workflows.workflow]]
name = "Spelling Slugger"
author = "user"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm ci --include=dev && npm run build:all && npm start"
waitForPort = 3000

[deployment]
deploymentTarget = "autoscale"
# --include=dev: the build itself needs vite and typescript even if NODE_ENV=production is set.
build = ["sh", "-c", "npm ci --include=dev && npm run build:all"]
run = ["npm", "start"]

[[ports]]
localPort = 3000
externalPort = 80
