{
  "name": "spelling-slugger",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "e2e": "playwright test",
    "lint": "oxlint",
    "icons": "node scripts/make-icons.mjs",
    "fixtures": "node scripts/make-fixture-pdfs.mjs",
    "build:server": "node scripts/build-server.mjs",
    "build:all": "npm run build && npm run build:server",
    "start": "node server/dist/index.mjs",
    "dev:api": "npm run build:server && DATABASE_URL=${DATABASE_URL:-pglite://.data/dev} SECURE_COOKIES=0 node server/dist/index.mjs",
    "reset-password": "npm run -s build:server && node server/dist/cli.mjs reset-password",
    "bake-audio": "node scripts/bake-audio.mjs",
    "process-audio": "node scripts/process-audio.mjs"
  },
  "dependencies": {
    "@replit/object-storage": "^1.0.0",
    "express": "^5.3.0",
    "msedge-tts": "^2.1.1",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "phaser": "^3.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "oxlint": "^1.88.0",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
